{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "allowImportingTsExtensions": true, "strict": true, "skipLibCheck": true, "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": { "#/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts", "server"]
}
